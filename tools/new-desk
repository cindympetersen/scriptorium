#!/usr/bin/env bash
#
# new-desk — scaffold a private writing-desk instance from the scriptorium framework.
#
# Usage:
#   new-desk <dest> [--framework <url|path>] [--style <name>]
#
#   <dest>              Where to create the instance (e.g. ~/code/writing-desk).
#   --framework <ref>   Submodule source for the framework — YOUR FORK, normally
#                       (git@github.com:you/scriptorium.git), so the framework is
#                       yours to tune and the desk has somewhere to push framework
#                       changes. A local checkout path also works, for development
#                       before it is pushed. Defaults to upstream, and says so.
#   --style <name>      Starter style to copy in as your first voice. Default:
#                       plain-english (copied to styles/my-voice).
#
# Creates the instance repo, mounts scriptorium as a submodule at framework/,
# wires the shared skills, drops a starter style and a first piece, adds CI (the
# GitHub workflow and the pre-push check, from templates/desk), and makes the
# initial commit — a desk whose first push is green. It does NOT create or push a
# GitHub repo — you do that when you're ready (the script prints the commands).

set -euo pipefail

UPSTREAM_URL="https://github.com/muffin-labs/scriptorium.git"
FRAMEWORK_URL="git@github.com:muffin-labs/scriptorium.git"
FRAMEWORK_GIVEN=0
STARTER_STYLE="plain-english"
SKILLS=(draft critique style-audit tune-style whats-on-the-desk)

die() { printf 'new-desk: %s\n' "$1" >&2; exit 1; }

DEST=""
while [ $# -gt 0 ]; do
  case "$1" in
    --framework) FRAMEWORK_URL="${2:?--framework needs a value}"; FRAMEWORK_GIVEN=1; shift 2 ;;
    --style)     STARTER_STYLE="${2:?--style needs a value}"; shift 2 ;;
    -h|--help)   sed -n '2,20p' "$0"; exit 0 ;;
    -*)          die "unknown option: $1" ;;
    *)           [ -z "$DEST" ] || die "unexpected argument: $1"; DEST="$1"; shift ;;
  esac
done

[ -n "$DEST" ] || die "need a destination path (see --help)"
command -v git >/dev/null || die "git not found on PATH"

# Resolve a local --framework path to absolute so the submodule ref is stable.
if [ -d "$FRAMEWORK_URL" ]; then
  FRAMEWORK_URL="$(cd "$FRAMEWORK_URL" && pwd)"
fi

if [ -e "$DEST" ]; then
  [ -d "$DEST" ] && [ -z "$(ls -A "$DEST" 2>/dev/null)" ] || die "destination exists and is not empty: $DEST"
fi

mkdir -p "$DEST"
DEST="$(cd "$DEST" && pwd)"
NAME="$(basename "$DEST")"
cd "$DEST"

echo "==> git init ($NAME)"
git init -q -b main 2>/dev/null || { git init -q && git symbolic-ref HEAD refs/heads/main; }

echo "==> adding scriptorium as a submodule ($FRAMEWORK_URL)"
# Local-path submodules need file protocol explicitly allowed; scope it to this
# one command rather than changing the user's global git config.
git -c protocol.file.allow=always submodule add -q "$FRAMEWORK_URL" framework \
  || die "submodule add failed. If scriptorium isn't pushed yet, pass --framework <local path>."
# The framework is meant to be a FORK: upstream stays reachable as a second remote inside the
# submodule, so `git -C framework pull upstream main` brings in what changed there, and your own
# framework commits go to `origin` (your fork). A desk mounting upstream directly is told so.
if [ "$FRAMEWORK_GIVEN" = 1 ] && [ "$FRAMEWORK_URL" != "$UPSTREAM_URL" ] \
   && [ "$FRAMEWORK_URL" != "git@github.com:muffin-labs/scriptorium.git" ]; then
  git -C framework remote add upstream "$UPSTREAM_URL" 2>/dev/null || true
  echo "    framework/ is your fork; 'upstream' points at muffin-labs/scriptorium"
else
  echo "    NOTE: framework/ mounts upstream directly. Fork github.com/muffin-labs/scriptorium and"
  echo "    pass --framework git@github.com:YOU/scriptorium.git so your framework changes have a home."
fi

echo "==> wiring shared skills"
mkdir -p .claude/skills
for s in "${SKILLS[@]}"; do
  ln -snf "../../framework/skills/$s" ".claude/skills/$s"
done

echo "==> copying behavior file"
cp framework/CLAUDE.md ./CLAUDE.md

echo "==> adding CI: the GitHub workflow and the pre-push check"
# .github/workflows/tests.yml runs the suite on GitHub; .githooks/pre-push runs the same command on
# each pushed commit before it leaves. core.hooksPath is switched on after the commit below.
cp -R framework/templates/desk/. ./
chmod +x .githooks/pre-push

echo "==> bringing in starter style '$STARTER_STYLE' as styles/my-voice"
[ -d "framework/styles/$STARTER_STYLE" ] || die "no such starter style: $STARTER_STYLE"
mkdir -p styles
cp -R "framework/styles/$STARTER_STYLE" styles/my-voice
# Rename the copied constitution's header so it names the new style, not the source.
sed -i.bak "1s|^# Style — .*|# Style — my-voice|" styles/my-voice/style.md && rm -f styles/my-voice/style.md.bak
# Declare the seed, so voice_privacy reads the starter's own text as inherited, not as this private
# voice leaking into the framework (it never infers that; it is told).
printf '\nseeded_from: %s\n' "$STARTER_STYLE" >> styles/my-voice/config.yaml

echo "==> creating first piece"
mkdir -p pieces/first-piece
cp -R framework/templates/piece/. pieces/first-piece/
# A real title: the README's H1 and publish.yaml must name the piece the same way (check_refs).
sed -i.bak -e 's|^title: <post title>|title: First piece|' \
           -e 's|^subtitle: <one-line subtitle>|subtitle: A throwaway to test the loop|' \
  pieces/first-piece/publish.yaml && rm -f pieces/first-piece/publish.yaml.bak
cat > pieces/first-piece/README.md <<'EOF'
# First piece

**Stage:** idea
**Style:** my-voice
**Updated:** (set on first session)

## What it is
A throwaway to test the loop: draft → critique → tune-style. Replace or delete it.

## Next move
Ask Claude "what's on the desk", or "draft this in my-voice".

## Open questions
—

## Links
- [outline.md](outline.md)
- [draft.md](draft.md)
- [notes.md](notes.md)
- [log/](log/)
EOF

cat > DASHBOARD.md <<'EOF'
# Desk

One block per piece in flight. The README is truth; this is the summary.

## first-piece
**Stage:** idea · **Style:** my-voice
**Next:** draft it, or delete and start your own.
EOF

cat > .gitignore <<'EOF'
.DS_Store
.claude/settings.local.json
scratch/
EOF

echo "==> initial commit"
git add -A
git commit -qm "Scaffold writing desk from scriptorium"

echo "==> turning on the pre-push check"
# Per-clone config, never committed: every OTHER clone runs `prepush.py install` once.
git config core.hooksPath .githooks
git -C framework config core.hooksPath .githooks

cat <<EOF

Done. Your desk is at:
  $DEST

Skills wired:   ${SKILLS[*]}
Starter style:  styles/my-voice (from $STARTER_STYLE)
First piece:    pieces/first-piece
CI:             .github/workflows/tests.yml on GitHub, and a pre-push check that runs the
                same command first (its venv is built on the first push; needs the network)

In any other clone of this desk, turn the pre-push check on once:
  python3 framework/tools/prepush.py install

Next:
  cd $DEST
  # open in Claude Code and try:  "what's on the desk"
  # when ready to back it up privately:
  gh repo create <you>/$NAME --private --source=. --remote=origin
  git push -u origin main
EOF
